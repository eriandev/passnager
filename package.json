    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "release-it": "21.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "svelte-motion": "0.12.2",
    "svelte-sonner": "1.2.1",
    "tailwindcss": "4.3.3",
